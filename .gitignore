# base-folder:start v1
# secrets: never in the base
.env
.env.*
*.pem
*.key
*.p12
secrets/
# caches and generated indexes
.brain/search.db
.brain/backups/
.brain/collector.lock
.brain/watch.lock
.brain/kick
.brain/map.json
.brain/*.tmp
.brain/pycache/
.brain/wiki.lock
.brain/tidy.json
.brain/tidy.log
.brain/.*.tmp*
.base-folder/
__pycache__/
*.pyc
graphify-out/
.obsidian/workspace*.json
.trash/
# big media (keep transcripts in raw/videos/, not the video files)
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.zip
# layout: code, heavy data and tool dirs live in the base but never in its git (deny by default)
/projects/*
!/projects/README.md
/data/
/apps/
/runs/
/scratch/
/backups/
/engines/**
!/engines/README.md
!/engines/*/
!/engines/*/*.md
!/engines/*/MIRROR
!/engines/*/agents/
!/engines/*/agents/**
!/engines/*/skills/
!/engines/*/skills/**
!/engines/*/memories/
!/engines/*/memories/**
!/engines/*/hooks/
!/engines/*/hooks/**
!/engines/*/scripts/
!/engines/*/scripts/**
!/engines/*/cron/
!/engines/*/cron/jobs.json
!/engines/*/profiles/
!/engines/*/profiles/*/
!/engines/*/profiles/*/SOUL.md
!/engines/*/profiles/*/memories/
!/engines/*/profiles/*/memories/**
!/engines/*/profiles/*/skills/
!/engines/*/profiles/*/skills/**
# hard denies last: they win over every line above
/engines/**/.credentials*
/engines/**/.claude.json*
/engines/**/auth*
/engines/**/.env
/engines/**/.env.*
/engines/**/*token*
/engines/**/*secret*
/engines/**/*.pem
/engines/**/*.key
/engines/**/vault/
/engines/**/pairing/
/engines/**/mcp-tokens/
/engines/**/sessions/
/engines/**/projects/
/engines/**/*.db
/engines/**/*.db-*
/engines/**/*.sqlite*
/engines/**/cache/
/engines/**/logs/
/engines/**/*.log
/engines/**/node_modules/
/engines/**/*.jsonl
/engines/**/telegram_*
/engines/**/browser-profile/
/engines/**/.git/
# base-folder:end
